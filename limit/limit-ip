#!/bin/bash

# Fungsi Kirim Notifikasi Telegram
function send_log(){
    if [ ! -f "/etc/bot/.bot.db" ]; then return; fi
    CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 3)
    KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 2)
    if [[ -z "$CHATID" || -z "$KEY" ]]; then return; fi
    
    TIME="10"
    URL="https://api.telegram.org/bot$KEY/sendMessage"
    TEXT="
<code>────────────────────</code>
<b>⚠️ PERINGATAN MULTI LOGIN ⚠️</b>
<code>────────────────────</code>
<code>Protokol  : </code><code>${proto^^}</code>
<code>Username  : </code><code>$user</code>
<code>Limit IP  : </code><code>$iplimit</code>
<code>Terdeteksi: </code><code>$cekcek IP</code>
<code>────────────────────</code>
"
    curl -s --max-time $TIME -d "chat_id=$CHATID&disable_web_page_preview=1&text=$TEXT&parse_mode=html" $URL >/dev/null 2>&1
}

# Fungsi Hapus Klien dengan Aman via JQ
remove_xray_client() {
    local target_email="$1"
    local config_file="/etc/xray/config.json"
    
    if [ ! -f "$config_file" ]; then return; fi
    
    # Backup config sebelum manipulasi
    cp "$config_file" "${config_file}.bak"
    
    # Gunakan jq untuk memfilter keluar client berdasarkan email/username
    jq --arg email "$target_email" '
      .inbounds[].settings.clients |= if . then map(select(.email != $email)) else . end
    ' "$config_file" > "${config_file}.tmp"
    
    # Validasi sintaks sebelum menimpa config asli
    if jq empty "${config_file}.tmp" >/dev/null 2>&1; then
        mv "${config_file}.tmp" "$config_file"
        systemctl restart xray >/dev/null 2>&1
    else
        rm -f "${config_file}.tmp"
    fi
}

function check_limit(){
    proto="$1"
    dir_limit="/etc/kyt/limit/${proto}/ip"
    
    if [ ! -d "$dir_limit" ]; then return; fi
    
    # Bersihkan file log jika sudah terlalu besar (> 10MB)
    if [ -f "/var/log/xray/access.log" ]; then
        log_size=$(stat -c%s "/var/log/xray/access.log" 2>/dev/null || echo 0)
        if [ "$log_size" -gt 10485760 ]; then
            echo -n > /var/log/xray/access.log
        fi
    fi
    
    users=( $(ls "$dir_limit") )
    for user in "${users[@]}"; do
        iplimit=$(cat "${dir_limit}/${user}" 2>/dev/null)
        if [[ -z "$iplimit" || "$iplimit" -le 0 ]]; then continue; fi
        
        # Ekstrak IP unik dari log akses
        ehh=$(grep -E "${user}" /var/log/xray/access.log 2>/dev/null | cut -d " " -f 3 | sed 's/tcp://g' | cut -d ":" -f 1 | sort -u)
        cekcek=$(echo "$ehh" | sed '/^$/d' | wc -l)
        
        if [[ $cekcek -gt $iplimit ]]; then
            # Kirim log telegram
            send_log
            
            # Cabut akun dari config secara aman tanpa merusak JSON
            remove_xray_client "$user"
            
            # Hapus database lokal
            rm -f "/etc/${proto}/.${proto}.db"
            rm -f "${dir_limit}/${user}"
            break
        fi
    done
}

case "$1" in
    vmip)
        check_limit "vmess"
        ;;
    vlip)
        check_limit "vless"
        ;;
    trip)
        check_limit "trojan"
        ;;
    *)
        echo "Usage: $0 {vmip|vlip|trip}"
        exit 1
        ;;
esac
