#!/bin/bash

function send_log_quota(){
    if [ ! -f "/etc/bot/.bot.db" ]; then return; fi
    CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 3)
    KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 2)
    if [[ -z "$CHATID" || -z "$KEY" ]]; then return; fi
    
    TIME="10"
    URL="https://api.telegram.org/bot$KEY/sendMessage"
    TEXT="
<code>────────────────────</code>
<b>⚠️ KUOTA TUNNELING HABIS ⚠️</b>
<code>────────────────────</code>
<code>Username  : </code><code>$user</code>
<code>Batas     : </code><code>$total_limit</code>
<code>Pemakaian : </code><code>$total_usage</code>
<code>────────────────────</code>
"
    curl -s --max-time $TIME -d "chat_id=$CHATID&disable_web_page_preview=1&text=$TEXT&parse_mode=html" $URL >/dev/null 2>&1
}

function bytes_to_human() {
    local -i b=$1
    if [[ $b -lt 1024 ]]; then
        echo "${b} B"
    elif [[ $b -lt 1048576 ]]; then
        echo "$(( (b + 1023)/1024 )) KB"
    elif [[ $b -lt 1073741824 ]]; then
        echo "$(( (b + 1048575)/1048576 )) MB"
    else
        echo "$(( (b + 1073741823)/1073741824 )) GB"
    fi
}

remove_client_safe() {
    local target_email="$1"
    local config_file="/etc/xray/config.json"
    
    if [ ! -f "$config_file" ]; then return; fi
    
    cp "$config_file" "${config_file}.bak"
    jq --arg email "$target_email" '
      .inbounds[].settings.clients |= if . then map(select(.email != $email)) else . end
    ' "$config_file" > "${config_file}.tmp"
    
    if jq empty "${config_file}.tmp" >/dev/null 2>&1; then
        mv "${config_file}.tmp" "$config_file"
        systemctl restart xray >/dev/null 2>&1
    else
        rm -f "${config_file}.tmp"
    fi
}

mkdir -p /etc/limit/vmess /etc/limit/vless /etc/limit/trojan /etc/vmess /etc/vless /etc/trojan

while true; do
    sleep 30
    
    # Ambil seluruh email klien aktif langsung dari config via JQ
    users=( $(jq -r '.inbounds[].settings.clients[]? | .email' /etc/xray/config.json 2>/dev/null | grep -v 'default@' | sort -u) )
    
    for user in "${users[@]}"; do
        # Ambil statistik trafik downlink & uplink via gRPC API
        downlink=$(xray api stats --server=127.0.0.1:10000 -name "user>>>${user}>>>traffic>>>downlink" -reset 2>/dev/null | awk '/value/ {print $2}' | tr -d '"')
        uplink=$(xray api stats --server=127.0.0.1:10000 -name "user>>>${user}>>>traffic>>>uplink" -reset 2>/dev/null | awk '/value/ {print $2}' | tr -d '"')
        
        downlink=${downlink:-0}
        uplink=${uplink:-0}
        traffic_now=$(( downlink + uplink ))
        
        # Simpan akumulasi pemakaian
        usage_file="/etc/limit/vmess/${user}"
        prev_usage=$(cat "$usage_file" 2>/dev/null || echo 0)
        new_usage=$(( prev_usage + traffic_now ))
        echo "$new_usage" > "$usage_file"
        
        # Periksa batas kuota
        quota_limit_file="/etc/vmess/${user}"
        if [ -f "$quota_limit_file" ]; then
            max_quota=$(cat "$quota_limit_file" 2>/dev/null || echo 0)
            
            if [[ "$max_quota" -gt 0 && "$new_usage" -ge "$max_quota" ]]; then
                total_usage=$(bytes_to_human "$new_usage")
                total_limit=$(bytes_to_human "$max_quota")
                
                # Kirim log Telegram
                send_log_quota
                
                # Cabut akun dari Xray dengan aman
                remove_client_safe "$user"
                
                # Bersihkan data limit
                rm -f "$quota_limit_file"
                rm -f "$usage_file"
                rm -f "/etc/kyt/limit/vmess/ip/${user}"
            fi
        fi
    done
done
